{
    "$schema": "https://raw.githubusercontent.com/Azure/enterprise-azure-policy-as-code/main/Schemas/policy-definition-schema.json",
    // EPAC reads .jsonc files, and the Azure Policy Linter parses comments and trailing commas too,
    // so you can annotate definitions without a preprocessing step.
    "name": "rg-require-environment-tag",
    "type": "Microsoft.Authorization/policyDefinitions",
    "properties": {
        "displayName": "Resource groups should have an 'environment' tag",
        "policyType": "Custom",
        "mode": "All",
        "description": "Audits or denies resource groups that are created or updated without the required tag. Use the tagName parameter to require a different tag.",
        "metadata": {
            "version": "1.0.0",
            "category": "Tags"
        },
        "parameters": {
            "tagName": {
                "type": "String",
                "metadata": {
                    "displayName": "Tag name",
                    "description": "Name of the tag that every resource group must carry."
                },
                "defaultValue": "environment"
            },
            "effect": {
                "type": "String",
                "metadata": {
                    "displayName": "Effect",
                    "description": "Enable or disable the execution of the policy."
                },
                "allowedValues": [
                    "Audit",
                    "Deny",
                    "Disabled"
                ],
                "defaultValue": "Audit"
            }
        },
        "policyRule": {
            "if": {
                "allOf": [
                    {
                        "field": "type",
                        "equals": "Microsoft.Resources/subscriptions/resourceGroups"
                    },
                    {
                        // tags[...] is a dynamic field reference, so the tag name can come from a parameter.
                        "field": "[concat('tags[', parameters('tagName'), ']')]",
                        "exists": "false"
                    }
                ]
            },
            "then": {
                "effect": "[parameters('effect')]"
            }
        }
    }
}
