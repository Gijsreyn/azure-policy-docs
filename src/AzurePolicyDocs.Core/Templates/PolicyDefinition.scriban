| Role | Role definition ID |
| :-- | :-- |
{{~ for role in policy.effectDetails.roleDefinitions ~}}
| {{ role.name ?? "Unknown role" }} | `{{ role.guid }}` |
{{~ end ~}}
{{~ end ~}}
