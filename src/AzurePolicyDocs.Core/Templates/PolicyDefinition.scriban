Modify operations:

| Operation | Field |
| :-- | :-- |
{{~ for operation in policy.effectDetails.modifyOperations ~}}
| `{{ operation.operation }}` | {{ if operation.field }}`{{ md_cell operation.field }}`{{ end }} |
{{~ end ~}}
{{~ end ~}}
