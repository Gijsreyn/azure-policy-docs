{{~ func md_cell(value) ~}}
{{~ if value == null ~}}
{{~ ret "" ~}}
{{~ end ~}}
{{~ ret (value | string.replace "\r\n" " " | string.replace "\n" " " | string.replace "|" "\\|") ~}}
{{~ end ~}}
{{~ func code_list(values) ~}}
{{~ if values == null || values.size == 0 ~}}
{{~ ret "" ~}}
{{~ end ~}}
{{~ result = "" ~}}
{{~ for value in values ~}}
{{~ result = result + "`" + (md_cell value) + "`" ~}}
{{~ if !for.last ~}}
{{~ result = result + ", " ~}}
{{~ end ~}}
{{~ end ~}}
{{~ ret result ~}}
{{~ end ~}}
# {{ policy.displayName ?? policy.name }}
{{~ if policy.description ~}}

{{ policy.description }}
{{~ end ~}}

| Property | Value |
| :-- | :-- |
| Name | `{{ policy.name }}` |
| Type | Policy set definition |
{{~ if policy.policyType ~}}
| Policy type | {{ policy.policyType }} |
{{~ end ~}}
{{~ if policy.category ~}}
| Category | {{ md_cell policy.category }} |
{{~ end ~}}
{{~ if policy.version ~}}
| Version | `{{ policy.version }}` |
{{~ end ~}}
| Policies | {{ policy.policyCount }} |
{{~ if policy.preview ~}}
| Preview | Yes |
{{~ end ~}}
{{~ if policy.deprecated ~}}
| Deprecated | Yes |
{{~ end ~}}

