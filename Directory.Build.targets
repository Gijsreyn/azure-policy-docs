<Project>
  <!-- Each packable project ships its own README, selected by PackageId. -->
  <ItemGroup Condition="'$(IsPackable)' == 'true'">
    <None
      Include="$(MSBuildThisFileDirectory)docs/packages/$(PackageId)/README.md"
      Pack="true"
      PackagePath="\"
      Visible="false"
    />
  </ItemGroup>
</Project>
