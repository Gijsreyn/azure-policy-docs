<Project>
  <PropertyGroup>
    <!-- Local builds only. semantic-release overrides Version for both packages in CI. -->
    <Version>0.0.0-development</Version>

    <!-- Use the target framework's supported C# version (.NET 10 defaults to C# 14). -->
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- CS1591: missing XML comment. Public types are documented; private helpers are not. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
    <Deterministic>true</Deterministic>
    <PlatformTarget>AnyCPU</PlatformTarget>
  </PropertyGroup>

  <PropertyGroup Label="Package metadata">
    <Authors>Gijs Reijn</Authors>
    <Copyright>Copyright (c) $([System.DateTime]::UtcNow.Year) $(Authors)</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/Gijsreyn/azure-policy-docs</PackageProjectUrl>
    <RepositoryUrl>https://github.com/Gijsreyn/azure-policy-docs</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageTags>azure;azure-policy;policy;governance;documentation;markdown;scriban;dotnet-tool</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
  </PropertyGroup>
</Project>
